{
  "name": "toms-diary-backend",
  "version": "0.1.0",
  "description": "Backend service for Tom's Diary - AI-powered handwritten journal",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "websocket",
    "ai",
    "handwriting",
    "vlm"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "canvas": "^3.2.2",
    "dotenv": "^17.3.1",
    "openai": "^6.33.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
